# Used by GoReleaser: the binary is built beforehand and copied in.
FROM busybox:1.36 AS dirs
RUN mkdir -p /data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=dirs --chown=65532:65532 /data /data
COPY llmproxy /usr/local/bin/llmproxy
WORKDIR /data
ENV LLMPROXY_LOG_DIR=/data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/llmproxy"]
